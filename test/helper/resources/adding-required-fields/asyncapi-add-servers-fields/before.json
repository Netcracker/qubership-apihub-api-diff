{
    "asyncapi": "3.0.0",
    "info": {
        "title": "AsyncAPI Example",
        "description": "Example",
        "version": "1.0.0"
    },
    "servers": {
        "production": {
            "description": "Production server"
        }
    },
    "channels": {
        "userSignup": {
            "address": "/api/v1/users/{userId}/signup",
            "description": "Channel for user signup events",
            "servers": [
                {}
            ]
        }
    },
    "operations": {
        "handleUserSignup": {
            "action": "receive",
            "summary": "Handle user signup",
            "description": "Process user signup requests",
            "security": [
                {
                    "$ref": "#/components/securitySchemes/bearerAuth"
                }
            ],
            "channel": {
                "$ref": "#/channels/userSignup"
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "tags": {
            "authTag": {
                "name": "authentication",
                "description": "Operations requiring authentication"
            },
            "publicTag": {
                "name": "public",
                "description": "Public endpoints"
            }
        },
        "servers": {
            "development": {
                "description": "Development server"
            }
        }
    }
}