{
    "asyncapi": "3.0.0",
    "info": {
        "title": "AsyncAPI Example",
        "description": "Example",
        "version": "1.0.0",
        "externalDocs": {
            "url": "https://api.example.com/docs",
            "description": "Additional API documentation"
        },
        "tags": {
            "infoTag": {
                "name": "info",
                "description": "Public endpoints",
                "externalDocs": {
                    "url": "https://api.example.com/docs",
                    "description": "Additional API documentation"
                }
            }
        }
    },
    "servers": {
        "production": {
            "host": "api.example.com",
            "protocol": "https",
            "description": "Production server",
            "externalDocs": {
                "url": "https://api.example.com/docs",
                "description": "Additional API documentation"
            },
            "tags": {
                "serverTag": {
                    "name": "server",
                    "description": "Public endpoints",
                    "externalDocs": {
                        "url": "https://api.example.com/docs",
                        "description": "Additional API documentation"
                    }
                }
            }
        }
    },
    "channels": {
        "userSignup": {
            "address": "/api/v1/users/{userId}/signup",
            "description": "Channel for user signup events",
            "externalDocs": {
                "url": "https://api.example.com/docs",
                "description": "Additional API documentation"
            },
            "tags": {
                "publicTag": {
                    "name": "public",
                    "description": "Public endpoints",
                    "externalDocs": {
                        "url": "https://api.example.com/docs",
                        "description": "Additional API documentation"
                    }
                }
            }
        }
    },
    "operations": {
        "handleUserSignup": {
            "action": "receive",
            "summary": "Handle user signup",
            "description": "Process user signup requests",
            "security": [
                {
                    "$ref": "#/components/securitySchemes/bearerAuth"
                }
            ],
            "channel": {
                "$ref": "#/channels/userSignup"
            },
            "tags": {
                "operationTag": {
                    "name": "operation",
                    "description": "Public endpoints",
                    "externalDocs": {
                        "url": "https://api.example.com/docs",
                        "description": "Additional API documentation"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "messages": {
            "signupRequest": {
                "summary": "User signup request",
                "description": "Request payload for user signup",
                "contentType": "application/json",
                "payload": {
                    "type": "object",
                    "properties": {
                        "userId": {
                            "type": "string"
                        },
                        "email": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        }
                    }
                },
                "externalDocs": {
                    "url": "https://api.example.com/docs",
                    "description": "Additional API documentation"
                }
            },
            "healthStatus": {
                "summary": "Health status",
                "description": "Service health status response",
                "contentType": "application/json",
                "payload": {
                    "type": "object",
                    "properties": {
                        "status": {
                            "type": "string",
                            "enum": [
                                "healthy",
                                "unhealthy"
                            ]
                        }
                    }
                },
                "tags": {
                    "messageTag": {
                        "name": "message",
                        "description": "Public endpoints",
                        "externalDocs": {
                            "url": "https://api.example.com/docs",
                            "description": "Additional API documentation"
                        }
                    }
                }
            }
        },
        "tags": {
            "componentTag": {
                "name": "component",
                "description": "Public endpoints",
                "externalDocs": {
                    "url": "https://api.example.com/docs",
                    "description": "Additional API documentation"
                }
            }
        }
    }
}